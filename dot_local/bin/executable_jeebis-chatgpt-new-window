#!/usr/bin/env python3
"""Open a fresh ChatGPT window on the workspace that requested it."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import time


def query(name):
    return json.loads(subprocess.check_output(["hyprctl", "-j", name]))


def dispatch(expression):
    subprocess.run(["hyprctl", "dispatch", expression], check=True,
                   stdout=subprocess.DEVNULL)


runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
with (runtime / f"jeebis-chatgpt-window-{os.getuid()}.lock").open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    workspace = query("activeworkspace")["name"]
    windows = [w for w in query("clients") if w["class"] == "chatgpt"]
    before = {w["address"] for w in windows}
    if windows:
        target = "address:" + windows[0]["address"]
        # The app's newWindow command is configured in ~/.codex/keybindings.json.
        dispatch('hl.dsp.send_shortcut({mods="CTRL + ALT + SHIFT",key="N",window='
                 + json.dumps(target) + '})')
    else:
        subprocess.Popen(["uwsm-app", "--", "chatgpt"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(150):
        for window in query("clients"):
            if window["class"] != "chatgpt" or window["address"] in before:
                continue
            target = json.dumps("address:" + window["address"])
            if window["workspace"]["name"] != workspace:
                dispatch('hl.dsp.window.move({window=' + target
                         + ',workspace=' + json.dumps(workspace) + ',silent=true})')
            # Do not steal focus if the user switched workspaces during startup.
            if query("activeworkspace")["name"] == workspace:
                dispatch('hl.dsp.focus({window=' + target + '})')
            raise SystemExit(0)
        time.sleep(0.1)
    subprocess.run(["notify-send", "ChatGPT", "新規ウィンドウの作成を確認できませんでした。"])
    raise SystemExit(1)
