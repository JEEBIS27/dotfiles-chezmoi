#!/bin/bash
set -euo pipefail

# The generated theme changes with Omarchy, while bat reads a compiled cache.
preview="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/preview.tmTheme"
[[ -f "$preview" ]] || exit 0
export PATH="$HOME/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
command -v bat >/dev/null 2>&1 || exit 0

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-bat-theme-${UID}.lock"
flock 9
bat cache --build >/dev/null
